PORT=7000
NODE_ENV=development
APP_NAME=Enterprise AI Assistant
APP_VERSION=2.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memora
# Production / Upstash: paste "Redis URL" (rediss://…) — overrides host/port below
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional Upstash REST (MCP, @upstash/redis); BullMQ still needs REDIS_URL above
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_ROOT=./storage
EMBEDDING_DIMENSIONS=1536
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# Optional: http://localhost:8001 when Node uses Python sidecar
AI_SERVICE_URL=
